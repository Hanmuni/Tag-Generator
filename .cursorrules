// -- FETCH API/ASYNC AWAIT --

// GET API REQUEST
const getApiEl = document.querySelector("#get");

const clickHandlerGet = async () => {
  try {
    const res = await fetch("https://reqres.in/api/users");
    const data = await res.json();

    if (!res.ok) {
      console.log(data.description);
      return;
    }

    console.log(data.data[3].first_name);
  } catch (error) {
    console.error();
  }
};

getApiEl.addEventListener("click", clickHandlerGet);

// POST API REQUEST (submit something)
const postApiEl = document.querySelector("#post");

const newUser = {
  name: "Zeno",
  job: "Director",
};

const clickHandlerPost = async () => {
  try {
    const res = await fetch("https://reqres.in/api/users", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(newUser),
    });
    const data = await res.json();

    if (!res.ok) {
      console.log(data.description);
      return;
    }

    console.log(data);
  } catch (error) {
    console.error();
  }
};

postApiEl.addEventListener("click", clickHandlerPost);

// -- Event Delegation & e.target --
// Intercept clicks on a parent element and target the specific child element that was clicked.
const removeNumber = (e) => {
  if (e.target.classList.contains("category-number")) {
    e.target.remove(); // Entfernt das geklickte Element direkt aus dem DOM
  }
};

// -- Modulo Operator (%) --
// Checks the remainder of a division (perfect for even/odd or divisibility)
10 % 2 === 0; // true (gerade)
15 % 5 === 0; // true (durch 5 teilbar)

// Remove multiple classes at once
elClass.classList.remove("is-right", "green");
// -- Logical Operators (!, &&, ||) & Guard Clauses --
let isActive = false;
// Logical NOT (!) → flips a boolean value
isActive = !isActive;
console.log(isActive); // true
// Guard clause using AND (&&)
// Logical AND (&&) → true ONLY if BOTH are true
// Logical OR (||) → true if AT LEAST ONE is true
const buttonEl = document.querySelector(".btn");
const headingEl = document.querySelector(".heading");
// Only run the code inside if BOTH elements actually exist in the HTML
if (buttonEl && headingEl) {
  buttonEl.addEventListener("click", () => {
    console.log("No crash! Both elements exist.");
  });
}
// -- State Management & UI Synchronization --
// 1. Define the state (JS variables that hold the data)
let isRight = false;
const boxEl = document.querySelector("#box");
// 2. Dedicated synchronization function to update the DOM
const updateUI = () => {
  if (isRight) {
    boxEl.classList.add("is-right");
  } else {
    boxEl.classList.remove("is-right");
  }
};
// 3. Event handler updates state first, then calls sync function
const moveBox = () => {
  isRight = !isRight; 
  updateUI(); 
};

// -- DOM CREATION & MOUNTING (MEMORY vs DOM) --
// 1. createElement: Builds "ghost" DOM nodes in memory
const charEl = document.createElement("span");
charEl.textContent = "A";
charEl.classList.add("character");

// 2. replaceChildren: Clears parent inner content and mounts new nodes in one operation
// 3. Spread Operator (...): Unpacks array box [span, span] into individual node arguments
const letterElements = [charEl];
const cursorEl = document.createElement("span");
textEl.replaceChildren(...letterElements, cursorEl);

// -- STRING SPLIT & ARRAY MAP --
const chars = "Hi".split(""); // ["H", "i"]
const elementArray = chars.map((char) => {
  const el = document.createElement("span");
  el.textContent = char;
  return el;
}); // Array of ghost DOM spans: [span, span]

// -- HARDWARE ACCELERATION & ANIMATION --
// 1. requestAnimationFrame: Synchronizes DOM updates with the browser's refresh rate (~60fps) for smooth animations
// 2. The Boolean Latch Pattern: Using a boolean (like frameRequested) to ensure a function is only scheduled once per frame, preventing rapid redundant executions
// 3. transform: translate(x, y): Used instead of top/left for moving elements, as it utilizes the GPU for better performance
// 4. Constants (UPPER_SNAKE_CASE): Used for hard-coded configuration values (like IDLE_TIMEOUT) to avoid "magic numbers"
// 5. CSS calc(): Remember that calc() requires spaces around the + and - operators!
